[
  {
    "kernelSource": {
      "name": "a02-kernel-release",
      "repo": "https://github.com/a02-trial/a022f_kernel",
      "branch": "physwizz",
      "device": "a02",
      "defconfig": "a02_defconfig"
    },
    "withKernelSU": false,
    "toolchains": [
      {
        "repo": "https://github.com/LineageOS/android_prebuilts_gcc_linux-x86_arm_arm-linux-androideabi-4.9",
        "branch": "lineage-18.1",
        "name": "proton-clang",
        "binPath": ["bin"]
      }
    ],
    "ccache": true,
    "params": {
      "ARCH": "arm",
      "CC": "clang",
      "externalCommand": {
        "CROSS_COMPILE": "proton-clang/bin/arm-linux-androideabi-"
      }
    },
    "AnyKernel3": {
      "use": true,
      "release": true,
      "repo": "https://github.com/osm0sis/AnyKernel3",
      "branch": "master"
    }
  }
]
