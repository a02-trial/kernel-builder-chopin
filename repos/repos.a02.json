[
  {
    "kernelSource": {
      "name": "a02-kernel-release",
      "repo": "https://github.com/a02-trial/a02kernel",
      "branch": main",
      "device": "a02",
      "defconfig": "a02_defconfig"
    },
    "withKernelSU": false,
    "toolchains": [
      {
        "repo": "https://github.com/kdrag0n/proton-clang",
        "branch": "master",
        "name": "proton-clang",
        "binPath": ["bin"]
      }
    ],
    "ccache": true,
    "params": {
      "ARCH": "arm",
      "CC": "clang",
      "externalCommand": {
        "CROSS_COMPILE": "proton-clang/bin/arm-linux-gnueabi-",
        "CROSS_COMPILE_ARM32": "proton-clang/bin/arm-linux-gnueabi-"
      }
    },
    "AnyKernel3": {
      "use": true,
      "release": true,
      "repo": "https://github.com/osm0sis/AnyKernel3",
      "branch": "master"
    }
  }
]
